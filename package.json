{
  "name": "bark-worker",
  "version": "0.1.0",
  "description": "Bark server implementation for Cloudflare Workers and D1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "build": "wrangler deploy --dry-run --env production --outdir dist",
    "deploy:production": "wrangler deploy --env production",
    "deploy:staging": "wrangler deploy --env staging",
    "dev": "wrangler dev",
    "migrate:local": "wrangler d1 migrations apply bark-worker-local --local",
    "types": "wrangler types",
    "upstream:sync": "node scripts/sync-upstream.mjs upstream/UPSTREAM.lock.json"
  },
  "dependencies": {
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2",
    "wrangler": "^4.149.0"
  }
}
