{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bark-worker-dev",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "preview_urls": true,
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
    },
  },
  "vars": {
    "ENVIRONMENT": "development",
    "URL_PREFIX": "/",
    "REGISTRATION_MODE": "open",
    "MAX_DEVICES": "16",
    "MAX_BATCH_PUSH_COUNT": "40",
    "MAX_REQUEST_BODY_BYTES": "65536",
    "APNS_REQUEST_TIMEOUT_MS": "10000",
    "APP_VERSION": "0.1.0",
    "APP_BUILD": "development",
    "APP_COMMIT": "development",
    "UPSTREAM_COMMIT": "3df8990fcbc407a3f5638eea8cedc3289d1a405d",
    "APNS_TOPIC": "me.fin.bark",
    "APNS_KEY_ID": "LH4T9V5U4R",
    "APNS_TEAM_ID": "5U8LBRXG3A",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bark-worker-local",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations",
    },
  ],
  "env": {
    "staging": {
      "name": "bark-worker-staging",
      "vars": {
        "ENVIRONMENT": "staging",
        "URL_PREFIX": "/",
        "REGISTRATION_MODE": "open",
        "MAX_DEVICES": "16",
        "MAX_BATCH_PUSH_COUNT": "40",
        "MAX_REQUEST_BODY_BYTES": "65536",
        "APNS_REQUEST_TIMEOUT_MS": "10000",
        "APP_VERSION": "0.1.0",
        "APP_BUILD": "development",
        "APP_COMMIT": "development",
        "UPSTREAM_COMMIT": "3df8990fcbc407a3f5638eea8cedc3289d1a405d",
        "APNS_TOPIC": "me.fin.bark",
        "APNS_KEY_ID": "LH4T9V5U4R",
        "APNS_TEAM_ID": "5U8LBRXG3A",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "bark-worker-staging-db",
          "database_id": "00000000-0000-0000-0000-000000000002",
          "migrations_dir": "migrations",
        },
      ],
    },
    "production": {
      "name": "bark-worker",
      "vars": {
        "ENVIRONMENT": "production",
        "URL_PREFIX": "/",
        "REGISTRATION_MODE": "open",
        "MAX_DEVICES": "16",
        "MAX_BATCH_PUSH_COUNT": "40",
        "MAX_REQUEST_BODY_BYTES": "65536",
        "APNS_REQUEST_TIMEOUT_MS": "10000",
        "APP_VERSION": "0.1.0",
        "APP_BUILD": "development",
        "APP_COMMIT": "development",
        "UPSTREAM_COMMIT": "3df8990fcbc407a3f5638eea8cedc3289d1a405d",
        "APNS_TOPIC": "me.fin.bark",
        "APNS_KEY_ID": "LH4T9V5U4R",
        "APNS_TEAM_ID": "5U8LBRXG3A",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "bark-worker-db",
          "database_id": "00000000-0000-0000-0000-000000000003",
          "migrations_dir": "migrations",
        },
      ],
    },
  },
}
